# Database module: RDS Postgres 16 + pgvector (DESIGN.md §3, §9).
# Isolated subnets only; reachable solely from the ECS security group.

variable "name_prefix" { type = string }
variable "vpc_id" { type = string }
variable "isolated_subnet_ids" { type = list(string) }
variable "ecs_sg_id" { type = string }
variable "kms_key_arn" { type = string }

variable "instance_class" { type = string }
variable "multi_az" { type = bool }
variable "allocated_storage" { type = number }

variable "db_name" {
  type    = string
  default = "saath"
}

resource "aws_db_subnet_group" "main" {
  name       = "${var.name_prefix}-db"
  subnet_ids = var.isolated_subnet_ids
  tags       = { Name = "${var.name_prefix}-db-subnets" }
}

resource "aws_security_group" "rds" {
  name        = "${var.name_prefix}-rds"
  description = "RDS Postgres: inbound 5432 from ECS tasks only"
  vpc_id      = var.vpc_id

  ingress {
    description     = "Postgres from ECS"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [var.ecs_sg_id]
  }

  # No egress: the database initiates nothing.
}

# Master password is generated by RDS and stored in Secrets Manager automatically;
# the API reads it from Secrets Manager at runtime (never from env files in git).
resource "aws_db_instance" "main" {
  identifier = "${var.name_prefix}-postgres"

  engine         = "postgres"
  engine_version = "16"
  instance_class = var.instance_class

  db_name                     = var.db_name
  username                    = "saath_admin"
  manage_master_user_password = true # writes to Secrets Manager

  allocated_storage = var.allocated_storage
  storage_type      = "gp3"
  storage_encrypted = true
  kms_key_id        = var.kms_key_arn

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.rds.id]
  multi_az               = var.multi_az
  publicly_accessible    = false

  backup_retention_period   = 7             # PITR window; prod raises this
  backup_window             = "20:00-21:00" # UTC
  maintenance_window        = "sun:21:00-sun:22:00"
  copy_tags_to_snapshot     = true
  deletion_protection       = true
  skip_final_snapshot       = false
  final_snapshot_identifier = "${var.name_prefix}-postgres-final"

  # pgvector is enabled by migration (CREATE EXTENSION vector) once the instance is up.
  parameter_group_name = aws_db_parameter_group.pg16.name

  tags = { Name = "${var.name_prefix}-postgres" }
}

resource "aws_db_parameter_group" "pg16" {
  name   = "${var.name_prefix}-pg16"
  family = "postgres16"

  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }

  parameter {
    name  = "log_connections"
    value = "1"
  }
}

output "endpoint" { value = aws_db_instance.main.address }
output "secret_arn" { value = aws_db_instance.main.master_user_secret[0].secret_arn }
