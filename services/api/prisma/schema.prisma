// Prisma schema — identity slice for P0 (DESIGN.md §9).
// RLS policies are applied via raw SQL appended to the init migration
// (Prisma does not manage RLS). Every user-data table gets:
// ENABLE + FORCE ROW LEVEL SECURITY and owner-scoped policies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  phoneHash    String    @unique @map("phone_e164_hash")
  phoneEnc     Bytes?    @map("phone_enc") // C4 — field-level encryption (P0-07)
  emailEnc     Bytes?    @map("email_enc") // C4
  status       String    @default("active")
  ageVerified  Boolean   @default(false) @map("age_verified")
  birthYear    Int?      @map("birth_year") @db.SmallInt
  gender       String?
  locale       String    @default("en")
  role         String    @default("member") // member | support | moderator | admin | superadmin (P2-06)
  createdVia   String    @default("self") @map("created_via")
  lastActiveAt DateTime? @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions Session[]
  consents Consent[]
  profile Profile?
  profileAttributes ProfileAttribute[]
  preference Preference?
  dealbreakers Dealbreaker[]
  softPreferences SoftPreference[]
  disclosurePolicy DisclosurePolicy?
  photos Photo[]
  onboardingSessions OnboardingSession[]
  kycChecks KycCheck[]
  blocksMade Block[] @relation("blocksMade")
  blocksReceived Block[] @relation("blocksReceived")
  reportsMade UserReport[] @relation("reportsMade")
  reportsReceived UserReport[] @relation("reportsReceived")
  riskScore RiskScore?
  safetyCases SafetyCase[]
  screeningA ScreeningResult[] @relation("screeningA")
  screeningB ScreeningResult[] @relation("screeningB")
  dailyMatchRows DailyMatch[] @relation("dailyMatchOwner")
  dailyMatchAppearances DailyMatch[] @relation("dailyMatchCandidate")
  interactionsMade Interaction[] @relation("interactionsMade")
  interactionsReceived Interaction[] @relation("interactionsReceived")
  familyOwned FamilyAccount[] @relation("familyOwner")
  familyMemberships FamilyAccount[] @relation("familyMember")
  familyInvitesSent FamilyAccount[] @relation("familyInviter")
  feedbackAuthored FamilyFeedback[] @relation("feedbackAuthor")
  feedbackReceived FamilyFeedback[] @relation("feedbackOwner")
  feedbackAbout FamilyFeedback[] @relation("feedbackCandidate")
  adminElevations AdminElevation[]
  adminAudit AdminAudit[]
  conversationsA Conversation[] @relation("conversationsA")
  conversationsB Conversation[] @relation("conversationsB")
  messagesSent Message[] @relation("messagesSent")
  notifications Notification[]
  notificationSetting NotificationSetting?
  subscriptions Subscription[]
  payments Payment[]
  invoices Invoice[]
  entitlement Entitlement?
  orders Order[]
  dsrRequests DsrRequest[]

  @@map("users")
}

/// Append-only consent ledger (P1-02). Withdrawal = new row with granted=false.
/// Application role has SELECT+INSERT only (no UPDATE/DELETE grant).
model Consent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  purpose       String
  noticeVersion String   @map("notice_version")
  granted       Boolean
  channel       String   @default("app")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt(sort: Desc)])
  @@map("consents")
}

/// One row per user (P1-03). Reference-data columns FK into the taxonomy —
/// the user SELF-selects; nothing is inferred (rule 10).
model Profile {
  userId             String   @id @map("user_id") @db.Uuid
  displayName        String?  @map("display_name")
  aboutNormalised    String?  @map("about_normalised")
  heightCm           Int?     @map("height_cm") @db.SmallInt
  maritalStatus      String?  @map("marital_status")
  hasChildren        Boolean  @default(false) @map("has_children")
  diet               String?
  educationLevel     String?  @map("education_level")
  profession         String?
  incomeBand         String?  @map("income_band")
  cityId             String?  @map("city_id")
  willingToRelocate  Boolean? @map("willing_to_relocate")
  religionId         String?  @map("religion_id")
  communityId        String?  @map("community_id")
  subCommunityId     String?  @map("sub_community_id")
  motherTongue       String?  @map("mother_tongue")
  visibility         String   @default("members")
  verificationTier   Int      @default(0) @map("verification_tier") @db.SmallInt
  profileVersion     Int      @default(1) @map("profile_version")
  /// C2: embedding of the A2-normalised structured summary (never raw bio).
  /// Written only via the save_embedding internal tool (P3-01, ADR-0012).
  /// Unsupported (pgvector): read/written with hand-written SQL, not Prisma DMMF.
  embedding          Unsupported("vector(1024")?
  /// P3-02 provenance: which summary (sha256) / model / versions produced the
  /// embedding. Regular columns (C2, inherits profiles RLS); written only via
  /// the save_embedding internal tool. embedding_updated_at = last embed write.
  embeddingSummaryHash    String?   @map("embedding_summary_hash")
  embeddingModelVersion   String?   @map("embedding_model_version")
  embeddingProfileVersion Int?      @map("embedding_profile_version")
  embeddingPrefVersion    Int?      @map("embedding_pref_version")
  embeddingUpdatedAt      DateTime? @map("embedding_updated_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city               TaxonomyCity?          @relation(fields: [cityId], references: [id])
  religion           TaxonomyReligion?      @relation(fields: [religionId], references: [id])
  community          TaxonomyCommunity?     @relation(fields: [communityId], references: [id])
  subCommunity       TaxonomySubCommunity?  @relation(fields: [subCommunityId], references: [id])

  @@map("profiles")
}

/// Community-specific attribute values (gotra, manglik…); validated against
/// AttributeDefinition in the service layer. Per-row visibility.
model ProfileAttribute {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  attributeKey  String   @map("attribute_key")
  value         Json
  visibility    String   @default("matches_only")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  definition    AttributeDefinition @relation(fields: [attributeKey], references: [key])

  @@index([userId, attributeKey])
  @@map("profile_attributes")
}

model Preference {
  userId                String   @id @map("user_id") @db.Uuid
  ageMin                Int?     @map("age_min") @db.SmallInt
  ageMax                Int?     @map("age_max") @db.SmallInt
  heightMin             Int?     @map("height_min") @db.SmallInt
  cities                String[] @default([])
  relocateOk            Boolean? @map("relocate_ok")
  communityFilter       Json?    @map("community_filter")
  openToAllCommunities  Boolean  @default(true) @map("open_to_all_communities")
  dietOk                String[] @default([]) @map("diet_ok")
  maritalOk             String[] @default([]) @map("marital_ok")
  version               Int      @default(1)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

model Dealbreaker {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  field     String
  rule      Json
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("dealbreakers")
}

model SoftPreference {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  topic            String
  stanceNormalised String   @map("stance_normalised")
  weight           Int      @default(50) @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, topic])
  @@map("soft_preferences")
}

/// Photo metadata + moderation ledger (P1-04). Files only via signed URLs.
model Photo {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  storageKey         String   @unique @map("storage_key")
  contentType        String   @map("content_type")
  byteSize           Int      @default(0) @map("byte_size")
  phash              String?
  moderationStatus   String   @default("pending") @map("moderation_status")
  isPrimary          Boolean  @default(false) @map("is_primary")
  blurForNonMatches  Boolean  @default(true) @map("blur_for_non_matches")
  sortOrder          Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt          DateTime @default(now()) @map("created_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("photos")
}

/// A1 onboarding interview (P1-06). Transcript stays private until the user
/// explicitly confirms their profile (status confirmed + visibility flip).
model OnboardingSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  locale    String   @default("en")
  status    String   @default("in_progress")
  turnCount Int      @default(0) @map("turn_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  OnboardingMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("onboarding_sessions")
}

model OnboardingMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String // 'user' | 'assistant'
  content   String
  seq       Int
  createdAt DateTime @default(now()) @map("created_at")
  session   OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, seq])
  @@map("onboarding_messages")
}

model DisclosurePolicy {
  userId     String   @id @map("user_id") @db.Uuid
  shareLevel String   @default("standard") @map("share_level")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("disclosure_policies")
}

/// A5/A6 screening verdict cache (P3-05, DESIGN.md A7.3/A7.4 + A9). One row
/// per normalised pair; invalidated by preference-version mismatch. Written
/// only by the A6 broker via the write_screening_result tool; service-context
/// RLS only — pair members never read rows directly.
model ScreeningResult {
  id           String   @id @default(uuid()) @db.Uuid
  userA        String   @map("user_a") @db.Uuid
  userB        String   @map("user_b") @db.Uuid
  prefVersionA Int      @map("pref_version_a")
  prefVersionB Int      @map("pref_version_b")
  verdict      String // COMPATIBLE | PARTIAL | INCOMPATIBLE
  score        Float    @db.DoublePrecision // 0..1 (CHECK in migration)
  topics       Json // [{topic, result}] — closed vocab, no free text
  reasonCodes  String[] @map("reason_codes") // closed vocabulary
  modelVersion String   @map("model_version")
  inputsHash   String   @map("inputs_hash") // sha256, audit (A7.4.6)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  userARef     User     @relation("screeningA", fields: [userA], references: [id], onDelete: Cascade)
  userBRef     User     @relation("screeningB", fields: [userB], references: [id], onDelete: Cascade)

  @@unique([userA, userB], map: "screening_results_pair_key")
  @@index([expiresAt])
  @@map("screening_results")
}

/// Daily feed rows (P3-07, DESIGN.md §8 step 9 + §9). One row per
/// (user, candidate, batch_date); publish is a replace-set per
/// (user, batch_date) so batch re-runs are idempotent. Explanations
/// (P3-09) live in explanationI18n.
model DailyMatch {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  candidateId     String   @map("candidate_id") @db.Uuid
  batchDate       DateTime @db.Date @map("batch_date")
  rank            Int
  explanationI18n Json?    @map("explanation_i18n")
  status          String   @default("published") // published | viewed | acted
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation("dailyMatchOwner", fields: [userId], references: [id], onDelete: Cascade)
  candidate       User     @relation("dailyMatchCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([userId, candidateId, batchDate], map: "daily_matches_pair_key")
  @@index([userId, batchDate(sort: Desc)])
  @@index([candidateId, batchDate])
  @@map("daily_matches")
}

/// Likes / passes / shortlists (P3-08, DESIGN.md §9). One row per
/// (actor, target, type); like⇄pass are exclusive dispositions (a post
/// flips the row). Owner reads own rows only — a target never learns who
/// liked/passed them (mutual-match reveal is P4).
model Interaction {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String   @map("actor_user_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  type         String // like | pass | shortlist
  reasonCode   String?  @map("reason_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  actor        User     @relation("interactionsMade", fields: [actorUserId], references: [id], onDelete: Cascade)
  target       User     @relation("interactionsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, targetUserId, type], map: "interactions_actor_target_type_key")
  @@index([actorUserId, type, createdAt])
  @@index([targetUserId, type])
  @@map("interactions")
}

/// Family Mode v1 (P3-10, DESIGN.md §9 + D7). One row per (owner, member);
/// member_user_id is NULL while the invite is pending (member binds at
/// accept time). Permissions are view/comment only in v1 — anything beyond
/// requires the owner's future approval, enforced by the service layer.
model FamilyAccount {
  id            String    @id @default(uuid()) @db.Uuid
  profileUserId String    @map("profile_user_id") @db.Uuid
  memberUserId  String?   @map("member_user_id") @db.Uuid
  relation      String
  permissions   Json      @default("{\"view\": true, \"comment\": true}")
  invitedBy     String    @map("invited_by") @db.Uuid
  status        String    @default("pending") // pending | accepted | expired | revoked
  inviteTokenHash String? @map("invite_token_hash")
  acceptedAt    DateTime? @map("accepted_at")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  owner         User      @relation("familyOwner", fields: [profileUserId], references: [id], onDelete: Cascade)
  member        User?     @relation("familyMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  inviter       User      @relation("familyInviter", fields: [invitedBy], references: [id], onDelete: Cascade)
  feedback      FamilyFeedback[]

  @@unique([profileUserId, memberUserId], map: "accounts_family_owner_member_key")
  @@map("accounts_family")
}

/// Structured family feedback on shortlisted candidates (P3-10, §9).
/// comment_enc is C4 (field-level encrypted by the service). Signal is a
/// closed vocabulary enforced by a migration CHECK.
model FamilyFeedback {
  id             String  @id @default(uuid()) @db.Uuid
  familyAccountId String @map("family_account_id") @db.Uuid
  familyMemberId String  @map("family_member_id") @db.Uuid
  profileUserId  String  @map("profile_user_id") @db.Uuid
  candidateId    String  @map("candidate_id") @db.Uuid
  signal         String // approve | reject | interested | concern
  commentEnc     Bytes?  @map("comment_enc")
  createdAt      DateTime @default(now()) @map("created_at")
  account        FamilyAccount @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)
  member         User      @relation("feedbackAuthor", fields: [familyMemberId], references: [id], onDelete: Cascade)
  owner          User      @relation("feedbackOwner", fields: [profileUserId], references: [id], onDelete: Cascade)
  candidate      User      @relation("feedbackCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([profileUserId, createdAt])
  @@index([candidateId])
  @@map("family_feedback")
}

model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId                 String?   @map("device_id")
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash") // rotation reuse detection
  ipHash                   String?   @map("ip_hash")
  ua                       String?
  expiresAt                DateTime  @map("expires_at")
  revokedAt                DateTime? @map("revoked_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@map("sessions")
}

/// Pre-auth OTP state. Identity infrastructure (not user data): RLS policy
/// requires the identity-service GUC instead of a user context.
model OtpCode {
  phoneHash String   @id @map("phone_e164_hash")
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("otp_codes")
}

/// LLM Gateway audit (DESIGN.md §9). Service-context RLS only.
model LlmCall {
  id               String   @id @db.Uuid
  agent            String
  userId           String?  @map("user_id") @db.Uuid
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  costPaise        Int      @default(0) @map("cost_paise")
  traceId          String   @map("trace_id")
  redactionApplied Boolean  @default(true) @map("redaction_applied")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("llm_calls")
}

// --- P1-01: taxonomy & attribute definitions (DESIGN.md §1.3, §9) -----------
// Reference data: world-readable through the API, writes are service-only
// (RLS: SELECT for all, no write policy for app_user).
// label_i18n shape: { "en": "...", "hi": "...", "ta": "..." }

model TaxonomyReligion {
  id          String              @id // slug, e.g. "hindu"
  labelI18n   Json                @map("label_i18n")
  sortOrder   Int                 @default(0) @map("sort_order")
  communities TaxonomyCommunity[]
  profiles Profile[]

  @@map("taxonomy_religion")
}

model TaxonomyCommunity {
  id             String                 @id // slug, e.g. "hindu-brahmin"
  religionId     String                 @map("religion_id")
  religion       TaxonomyReligion       @relation(fields: [religionId], references: [id])
  labelI18n      Json                   @map("label_i18n")
  sortOrder      Int                    @default(0) @map("sort_order")
  subCommunities TaxonomySubCommunity[]
  profiles Profile[]

  @@map("taxonomy_community")
}

model TaxonomySubCommunity {
  id          String            @id // slug
  communityId String            @map("community_id")
  community   TaxonomyCommunity @relation(fields: [communityId], references: [id])
  labelI18n   Json              @map("label_i18n")
  sortOrder   Int               @default(0) @map("sort_order")
  profiles Profile[]

  @@map("taxonomy_sub_community")
}

model TaxonomyCity {
  id        String @id // slug, e.g. "mumbai"
  labelI18n Json   @map("label_i18n")
  state     String // state slug, e.g. "maharashtra"
  country   String @default("IN")
  profiles Profile[]

  @@map("taxonomy_city")
}

/// Community-specific optional attributes (gotra, manglik_status, sect, diet…).
/// sensitivity is a data class (C1–C3) driving handling rules (§10.1).
model AttributeDefinition {
  key            String  @id // e.g. "gotra"
  communityScope String? @map("community_scope") // taxonomy_community.id or null = applies to all
  type           String // "text" | "single_select" | "multi_select" | "boolean"
  options        Json? // [{ "value": "...", "label_i18n": {...} }] for select types
  sensitivity    String  @default("C3")
  labelI18n      Json    @map("label_i18n")
  profileAttributes ProfileAttribute[]

  @@map("attribute_definitions")
}

/// Processed webhook event ids (P1-09, DESIGN.md §12: idempotent event ids).
/// Operational data (vendor ids only, no user content); service-only, no RLS.
model WebhookEvent {
  id        String   @id
  source    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("webhook_events")
}

/// KYC orchestration (P2-01, DESIGN.md A6/A10.4). Raw documents are NEVER
/// stored — only the result, provider reference, score and a masked ID.
/// Tier source of truth: profile.verification_tier (0 none / 1 ID / 2 +liveness
/// / 3 +employment) + users.age_verified / birth_year.
model KycCheck {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  provider      String
  providerRef   String   @map("provider_ref")
  type          String // 'id' | 'id_liveness' | 'employment'
  status        String   @default("pending") // pending | pass | fail | error
  score         Float?
  age           Int?     @db.SmallInt // provider age check (never exact DOB)
  nameMatch     Boolean? @map("name_match")
  maskedId      String?  @map("masked_id")
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([providerRef])
  @@map("kyc_checks")
}

/// Block list (P2-03, DESIGN.md J9/T8). Hides profiles both directions and
/// will suppress matches/messages (wired where those surfaces land).
model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("blocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/// User reports (P2-03). Append-only from the app role: status changes are a
/// moderator/service context action (admin console, P2-06).
model UserReport {
  id         String   @id @default(uuid()) @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  subjectId  String   @map("subject_id") @db.Uuid
  reason     String
  details    String?  @db.VarChar(1000)
  status     String   @default("open") // open | reviewing | resolved | dismissed
  createdAt  DateTime @default(now()) @map("created_at")
  reporter   User     @relation("reportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  subject    User     @relation("reportsReceived", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, status])
  @@index([reporterId])
  @@map("user_reports")
}

/// A3 risk scoring (P2-04): deterministic signals, recomputed on safety events.
/// Owner-readable score; writes happen in the 'risk' service context.
model RiskScore {
  userId     String   @id @map("user_id") @db.Uuid
  score      Int
  signals    Json // [{signal, weight, detail}] — auditability of the score
  computedAt DateTime @default(now()) @map("computed_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("risk_scores")
}

/// Human review queue (P2-04, DESIGN.md A3 exit rule): NEVER auto-ban from a
/// case — hard signals (underage) block via their own path. Service-context
/// only: there is deliberately no owner policy (deny by default).
model SafetyCase {
  id            String    @id @default(uuid()) @db.Uuid
  subjectId     String    @map("subject_id") @db.Uuid
  source        String // 'risk' | 'report' | 'kyc' | 'moderation' | 'a9'
  severity      String // low | medium | high | critical
  status        String    @default("open") // open | reviewing | resolved | dismissed
  decision      String?
  decidedBy     String?   @map("decided_by") @db.Uuid
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  subject       User      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, status])
  @@index([status, severity])
  @@map("safety_cases")
}

/// JIT admin elevation (P2-06, DESIGN.md A12.2): time-boxed, recorded, revoked
/// on demand. Solo mode allows self-grant (granted_by == user_id) — logged.
model AdminElevation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  grantedBy String    @map("granted_by") @db.Uuid
  reason    String
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("admin_elevations")
}

/// Append-only admin audit trail (P2-06 exit criterion 3): every admin view
/// and action writes a row. Ids/kinds only — never record contents (C4 stays
/// out of the log). No UPDATE/DELETE grants; service-context access.
model AdminAudit {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  action      String // admin.view.* | admin.action.*
  subjectKind String   @map("subject_kind") // user | case | audit | elevation
  subjectId   String?  @map("subject_id")
  meta        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([subjectKind, subjectId])
  @@map("admin_audit")
}

// --- P4-01: messaging (DESIGN.md §9 messaging + §14) ------------------------
// Mutual-match chat (opens on mutual like, P4-03), C4-encrypted bodies,
// pre-send contact masking, A9 moderation status, masked calls, notifications.

/// One row per unordered user pair. (user_a, user_b) is canonical: user_a's
/// uuid sorts before user_b's (service enforces on open). origin: 'mutual'
/// (both liked) | 'intro' (intro-pack credit spent, P4-06).
model Conversation {
  id              String    @id @default(uuid()) @db.Uuid
  userA           String    @map("user_a") @db.Uuid
  userB           String    @map("user_b") @db.Uuid
  origin          String    @default("mutual")
  status          String    @default("open") // open | closed
  openedAt        DateTime  @default(now()) @map("opened_at")
  /// Per-side contact-sharing opt-in (§10.2); both true → contact_shared_at.
  contactShareA   Boolean   @default(false) @map("contact_share_a")
  contactShareB   Boolean   @default(false) @map("contact_share_b")
  contactSharedAt DateTime? @map("contact_shared_at")
  lastMessageAt   DateTime? @map("last_message_at")
  /// A8 coordinator (P4-09): proposed call/meet slots (ISO strings, set by
  /// the propose_slots tool — suggestions to own user only).
  proposedSlots   Json?    @map("proposed_slots")
  /// Latest post-meeting feedback (A8 record_meeting_feedback); notes are
  /// C4-encrypted base64 inside the jsonb.
  meetingFeedback Json?    @map("meeting_feedback")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  userARel        User      @relation("conversationsA", fields: [userA], references: [id], onDelete: Cascade)
  userBRel        User      @relation("conversationsB", fields: [userB], references: [id], onDelete: Cascade)
  messages        Message[]
  callSessions    CallSession[]

  @@unique([userA, userB])
  @@index([userA, lastMessageAt(sort: Desc)])
  @@index([userB, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

/// Chat message (C4: body_enc via FieldCrypto — plaintext never touches the
/// DB/logs). moderation_status: pending | clean | flagged (A9 classify, P4-02).
/// clientRef is the client idempotency key: re-POSTing the same (sender,
/// clientRef) returns the original message instead of a duplicate.
model Message {
  id               String       @id @default(uuid()) @db.Uuid
  conversationId   String       @map("conversation_id") @db.Uuid
  senderId         String       @map("sender_id") @db.Uuid
  bodyEnc          Bytes        @map("body_enc")
  moderationStatus String       @default("pending") @map("moderation_status")
  clientRef        String?      @map("client_ref")
  createdAt        DateTime     @default(now()) @map("created_at")
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User         @relation("messagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientRef])
  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Masked call through the provider bridge (D2): numbers are never exposed;
/// only provider_ref + duration are stored.
model CallSession {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  initiatedBy    String       @map("initiated_by") @db.Uuid
  provider       String       @default("mock") // mock | exotel (provider interface, D2)
  providerRef    String       @map("provider_ref")
  status         String       @default("initiated") // initiated|ongoing|completed|failed|declined
  startedAt      DateTime?    @map("started_at")
  endedAt        DateTime?    @map("ended_at")
  durationSec    Int?         @map("duration_s")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @map("updated_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("call_sessions")
}

/// In-app notification (§14: quiet hours, frequency caps, per-channel prefs).
/// Payload is a closed-vocabulary jsonb (no free text, no C3/C4 data).
/// Types: match.mutual | message.received | subscription.activated |
/// intro_pack.credited | coordinator.suggestion.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    // match.mutual | message.received | subscription.activated
  payload   Json      @default("{}")
  channel   String    @default("inapp") // inapp (whatsapp delivery is P5+ polish)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Per-user notification preferences; defaults come from config (§14).
model NotificationSetting {
  userId        String   @id @map("user_id") @db.Uuid
  /// Quiet hours in minutes-from-midnight IST (§14; user-TZ capture is P5+).
  quietStartMin Int      @default(1320) @map("quiet_start_min") // 22:00
  quietEndMin   Int      @default(480) @map("quiet_end_min") // 08:00
  dailyCap      Int      @default(5) @map("daily_cap")
  channels      Json     @default("{\"inapp\":true,\"whatsapp\":false}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// --- P4-06: billing (DESIGN.md §13) ----------------------------------------
// Razorpay subscriptions + one-time intro packs, entitlements as the single
// source of truth for feature gating, sequential GST-inclusive invoices.

/// Plans + consumable intro packs. Reference data: world-readable through the
/// API, service-only writes, seeded by the P4-06 migration. prices are
/// GST-inclusive (§13 DECISION). features shape (documented):
/// { "chat": bool, "calls": bool, "dailyMessageLimit": int (-1 = unlimited),
///   "introCredits": int } — intro packs carry introCredits only.
model Plan {
  id         String  @id // slug: free | plus_monthly | plus_quarterly | intro_5
  kind       String  @default("plan") // plan | intro_pack
  pricePaise Int     @map("price_paise")
  interval   String? // monthly | quarterly | 6m (null for intro packs)
  /// GST rate in basis points (1800 = 18%); stored amount is tax-INCLUSIVE,
  /// the invoice splits out the GST portion.
  gstRateBps Int     @default(1800) @map("gst_rate_bps")
  features   Json
  active     Boolean @default(true)
  sortOrder  Int     @default(0) @map("sort_order")

  subscriptions Subscription[]
  orders Order[]

  @@map("plans")
}

/// Razorpay subscription lifecycle mirror. Status transitions ONLY from
/// verified webhook processing (P4-07) or server-side provider confirmation.
model Subscription {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  planId           String    @map("plan_id")
  provider         String    @default("razorpay")
  providerSubId    String    @unique @map("provider_sub_id")
  /// Client idempotency key (§11): re-POSTing the same (user, clientRef)
  /// returns the original subscription instead of a duplicate.
  clientRef        String?   @map("client_ref")
  status           String    @default("pending") // pending | active | cancelled | expired
  currentPeriodEnd DateTime? @map("current_period_end")
  /// Self-serve cancellation (§13): plan stays active to period end.
  cancelAtPeriodEnd Boolean  @default(false) @map("cancel_at_period_end")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             Plan      @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@map("subscriptions")
}

/// One-time order for a consumable intro pack (§13). The captured payment
/// arrives by webhook (payment.captured, provider order id) and credits the
/// pack's introCredits. clientRef is the client idempotency key.
model Order {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  planId          String   @map("plan_id")
  providerOrderId String   @unique @map("provider_order_id")
  clientRef       String?  @map("client_ref")
  amountPaise     Int      @map("amount_paise")
  status          String   @default("pending") // pending | captured | failed
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan     @relation(fields: [planId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
}

/// Single source of truth for feature gating (§13): written ONLY from
/// verified webhook processing (P4-07) or server-side confirmation — never
/// from client claims. Effective features = the user's plan row overlaid
/// with this row (intro credits, support grants, valid_until).
model Entitlement {
  userId       String    @id @map("user_id") @db.Uuid
  features     Json      @default("{}")
  introCredits Int       @default(0) @map("intro_credits")
  validUntil   DateTime? @map("valid_until")
  version      Int       @default(1)
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}

/// Payment ledger (one row per provider payment attempt that reaches us).
model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @default("razorpay")
  providerPaymentId String   @unique @map("provider_payment_id")
  providerOrderId   String?  @map("provider_order_id")
  providerSubId     String?  @map("provider_sub_id")
  amountPaise       Int      @map("amount_paise")
  status            String   @default("pending") // pending | captured | failed | refunded
  invoiceId         String?  @unique @map("invoice_id")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("payments")
}

/// GST invoice, sequential per calendar year (INV-<year>-<seq>). PDF
/// generation/storage lands with cloud infra (P5+ polish) — the ledger row
/// (number, amounts, GST split) is the billing record of truth for now.
model Invoice {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  invoiceNo          String   @unique @map("invoice_no")
  lineItem           String   @map("line_item") // plan / pack code
  amountPaise        Int      @map("amount_paise") // GST-inclusive
  gstPaise           Int      @map("gst_paise") // GST portion of the amount
  currency           String   @default("INR")
  providerPaymentId  String?  @map("provider_payment_id")
  createdAt          DateTime @default(now()) @map("created_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("invoices")
}

/// DPDP data-principal requests (P5-01, DESIGN.md §10.2): access (export),
/// erase (account deletion), grievance. `due_at` carries the statutory SLA
/// clock (grievances: GRIEVANCE_SLA_DAYS; erasure: retention window before
/// the sweeper hard-deletes/anonymises). Grievance text is C4-encrypted.
model DsrRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String    // access | erase | grievance
  status      String    @default("open") // open | in_progress | completed | cancelled
  detailsEnc  Bytes?    @map("details_enc")
  resolution  String?
  dueAt       DateTime  @map("due_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, status, dueAt])
  @@map("dsr_requests")
}
