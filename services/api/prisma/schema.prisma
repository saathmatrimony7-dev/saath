// Prisma schema — identity slice for P0 (DESIGN.md §9).
// RLS policies are applied via raw SQL appended to the init migration
// (Prisma does not manage RLS). Every user-data table gets:
// ENABLE + FORCE ROW LEVEL SECURITY and owner-scoped policies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  phoneHash    String    @unique @map("phone_e164_hash")
  phoneEnc     Bytes?    @map("phone_enc") // C4 — field-level encryption (P0-07)
  emailEnc     Bytes?    @map("email_enc") // C4
  status       String    @default("active")
  ageVerified  Boolean   @default(false) @map("age_verified")
  birthYear    Int?      @map("birth_year") @db.SmallInt
  gender       String?
  locale       String    @default("en")
  createdVia   String    @default("self") @map("created_via")
  lastActiveAt DateTime? @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions Session[]
  consents Consent[]

  @@map("users")
}

/// Append-only consent ledger (P1-02). Withdrawal = new row with granted=false.
/// Application role has SELECT+INSERT only (no UPDATE/DELETE grant).
model Consent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  purpose       String
  noticeVersion String   @map("notice_version")
  granted       Boolean
  channel       String   @default("app")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt(sort: Desc)])
  @@map("consents")
}

model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId                 String?   @map("device_id")
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash") // rotation reuse detection
  ipHash                   String?   @map("ip_hash")
  ua                       String?
  expiresAt                DateTime  @map("expires_at")
  revokedAt                DateTime? @map("revoked_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@map("sessions")
}

/// Pre-auth OTP state. Identity infrastructure (not user data): RLS policy
/// requires the identity-service GUC instead of a user context.
model OtpCode {
  phoneHash String   @id @map("phone_e164_hash")
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("otp_codes")
}

/// LLM Gateway audit (DESIGN.md §9). Service-context RLS only.
model LlmCall {
  id               String   @id @db.Uuid
  agent            String
  userId           String?  @map("user_id") @db.Uuid
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  costPaise        Int      @default(0) @map("cost_paise")
  traceId          String   @map("trace_id")
  redactionApplied Boolean  @default(true) @map("redaction_applied")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("llm_calls")
}

// --- P1-01: taxonomy & attribute definitions (DESIGN.md §1.3, §9) -----------
// Reference data: world-readable through the API, writes are service-only
// (RLS: SELECT for all, no write policy for app_user).
// label_i18n shape: { "en": "...", "hi": "...", "ta": "..." }

model TaxonomyReligion {
  id          String              @id // slug, e.g. "hindu"
  labelI18n   Json                @map("label_i18n")
  sortOrder   Int                 @default(0) @map("sort_order")
  communities TaxonomyCommunity[]

  @@map("taxonomy_religion")
}

model TaxonomyCommunity {
  id             String                 @id // slug, e.g. "hindu-brahmin"
  religionId     String                 @map("religion_id")
  religion       TaxonomyReligion       @relation(fields: [religionId], references: [id])
  labelI18n      Json                   @map("label_i18n")
  sortOrder      Int                    @default(0) @map("sort_order")
  subCommunities TaxonomySubCommunity[]

  @@map("taxonomy_community")
}

model TaxonomySubCommunity {
  id          String            @id // slug
  communityId String            @map("community_id")
  community   TaxonomyCommunity @relation(fields: [communityId], references: [id])
  labelI18n   Json              @map("label_i18n")
  sortOrder   Int               @default(0) @map("sort_order")

  @@map("taxonomy_sub_community")
}

model TaxonomyCity {
  id        String @id // slug, e.g. "mumbai"
  labelI18n Json   @map("label_i18n")
  state     String // state slug, e.g. "maharashtra"
  country   String @default("IN")

  @@map("taxonomy_city")
}

/// Community-specific optional attributes (gotra, manglik_status, sect, diet…).
/// sensitivity is a data class (C1–C3) driving handling rules (§10.1).
model AttributeDefinition {
  key            String  @id // e.g. "gotra"
  communityScope String? @map("community_scope") // taxonomy_community.id or null = applies to all
  type           String // "text" | "single_select" | "multi_select" | "boolean"
  options        Json? // [{ "value": "...", "label_i18n": {...} }] for select types
  sensitivity    String  @default("C3")
  labelI18n      Json    @map("label_i18n")

  @@map("attribute_definitions")
}
