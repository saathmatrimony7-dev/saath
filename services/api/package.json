{
  "name": "@saath/api",
  "version": "0.0.0",
  "private": true,
  "description": "Saath Core API — NestJS modular monolith (DESIGN.md §5)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "pretest": "pnpm -w run build:packages",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:rls": "vitest run test/rls",
    "test:authz": "vitest run test/authz",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.18.0",
    "@saath/crypto": "workspace:*",
    "@saath/logger": "workspace:*",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "jose": "^6.2.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.7.2",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "^6.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
