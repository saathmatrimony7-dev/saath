# Copy to .env.local (git-ignored) and fill in real values for local dev.
# NEVER commit real secrets. Cloud environments read from AWS Secrets Manager.

# --- Core API (services/api) ---
NODE_ENV=development
PORT=3000

# Local dev databases (Docker Compose). Cloud: RDS/ElastiCache via Secrets Manager.
DATABASE_URL=postgresql://saath:saath_dev_password@localhost:5432/saath
REDIS_URL=redis://localhost:6379

# Auth — development-only values, rotated real keys live in Secrets Manager.
JWT_ISSUER=saath-dev
JWT_KEY_ID=dev-key-1
# Base64-encoded ES256 private key for LOCAL DEV ONLY (generate: see services/api/README.md)
JWT_PRIVATE_KEY_ES256_B64=CHANGE_ME_DEV_ONLY

# OTP SMS provider: mock | msg91 (vendor account pending — MSG91 assumed, see ADR)
OTP_PROVIDER=mock
MSG91_AUTH_KEY=CHANGE_ME_DEV_ONLY

# Field-level encryption (crypto module) — LOCAL DEV master key, base64 32 bytes.
# Cloud: AWS KMS CMK per data class. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FLE_MASTER_KEY_B64=CHANGE_ME_DEV_ONLY

# --- LLM Gateway (Anthropic / Claude API — the ONLY runtime LLM provider) ---
# Ask the owner for a real key; CI uses a mock transport.
ANTHROPIC_API_KEY=CHANGE_ME_ASK_OWNER
LLM_MODEL_SMALL=claude-haiku-5-5
LLM_MODEL_MID=claude-sonnet-5-5
LLM_MODEL_LARGE=claude-opus-5-5
LLM_GATEWAY_TRANSPORT=mock
# Per-user daily token budgets by plan (paise-denominated cost tracked in llm_calls)
LLM_DAILY_TOKEN_BUDGET_FREE=20000
LLM_DAILY_TOKEN_BUDGET_PAID=200000
LLM_GLOBAL_CIRCUIT_BREAKER_TOKENS=50000000
